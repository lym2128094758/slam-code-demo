<launch>
  <node name="pointcloud_to_laserscan" pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node" output="screen">
    <remap from="cloud_in" to="/lidar/points"/>
    <remap from="scan" to="/scan"/>
    <!-- <param name="target_frame" value="radar"/> -->
    <param name="target_frame" value="radar"/>
    <param name="invert" value="false"/>
    <param name="min_height" value="-0.3"/>
    <param name="max_height" value="1.3"/>
    <param name="range_min" value="0.1"/>
    <param name="range_max" value="15.0"/>
  </node>

  <node name="amcl" pkg="amcl" type="amcl" output="screen">
    <param name="odom_frame_id" value="odom"/>
    <param name="base_frame_id" value="base_link"/>
    <param name="global_frame_id" value="map"/>
    <param name="use_map_topic" value="false"/>      <!-- 从true改成false，直接使用参数文件中的地图 -->
    <param name="first_map_only" value="false"/>
    <param name="transform_tolerance" value="1.0"/>
    <param name="gui_publish_rate" value="10.0"/>
    <param name="laser_max_beams" value="30"/>     <!-- 从30改成60，使用更多激光束 -->
    <param name="min_particles" value="500"/>          <!-- 最小粒子数 -->
    <param name="max_particles" value="2000"/>          <!-- 最大粒子数 -->
    <param name="update_min_d" value="0.05"/>          <!-- 距离更新阈值 -->
    <param name="update_min_a" value="0.05"/>          <!-- 角度更新阈值 -->

    <param name="laser_max_range" value="15.0"/>
    <param name="laser_min_range" value="0.1"/>
    <param name="laser_z_max_dist" value="0.8"/>   <!-- 从0.1改成0.8 -->  
    <param name="z_hit" value="0.5"/>             <!-- 正确匹配概率，从0.5改成0.85 -->
    <param name="z_rand" value="0.1"/>             <!-- 噪声概率，从0.5改成0.1 -->
    <param name="z_max" value="0.05"/>
    <param name="z_short" value="0.05"/>
  </node>
  <!-- <node name="odom_tf_publisher" pkg="simple_nav" type="odom_tf_publisher.py" output="screen"/> -->
  <!-- <node name="qpos_to_odom" pkg="simple_nav" type="qpos_to_odom.py" output="screen"/> -->
</launch>
